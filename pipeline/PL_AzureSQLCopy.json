{
	"name": "PL_AzureSQLCopy",
	"properties": {
		"activities": [
			{
				"name": "Get Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.00:10:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from sql_ingestion_config",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_azureSQL",
						"type": "DatasetReference",
						"parameters": {
							"DS_database": {
								"value": "@pipeline().globalParameters.sqldatabase",
								"type": "Expression"
							}
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Iterate through Configs",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Config').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Get Max timestamp",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Insert audit entry",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.0:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Azure_SQL",
								"type": "LinkedServiceReference",
								"parameters": {
									"database": {
										"value": "@item().sql_server_database_name",
										"type": "Expression"
									}
								}
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "@concat('select max(ModifiedDate) as max_ts from ',item().sql_table_name )",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Check for new rows",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Max timestamp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('Get Max timestamp').output.resultSets[0].rows[0].max_ts,\nitem().WatermarkValue\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Update Audit Entry EMPTY RUN",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [],
										"policy": {
											"timeout": "0.0:10:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[Update_audit_entry]",
											"storedProcedureParameters": {
												"AuditID": {
													"value": {
														"value": "@activity('Insert audit entry').output.firstRow.AuditID",
														"type": "Expression"
													},
													"type": "Int64"
												},
												"ErrorMessage": {
													"value": "No new rows",
													"type": "String"
												},
												"PipelineStatus": {
													"value": "Success",
													"type": "String"
												},
												"RowsCopied": {
													"value": "0",
													"type": "Int64"
												},
												"RowsInserted": {
													"value": "0",
													"type": "Int64"
												},
												"RunEndTime": {
													"value": {
														"value": "@formatDateTime(utcNow())",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"WatermarkEndValue": {
													"value": {
														"value": "@activity('Get Max timestamp').output.resultSets[0].rows[0].max_ts",
														"type": "Expression"
													},
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_Azure_SQL",
											"type": "LinkedServiceReference",
											"parameters": {
												"database": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "Incremental Copy",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.0:30:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "AzureSqlSource",
												"sqlReaderQuery": {
													"value": "@concat(\n    'select * from ',\n    item().sql_table_name,\n    ' where ModifiedDate > ''',\n    formatDateTime(\n        item().WatermarkValue,\n        'yyyy-MM-dd HH:mm:ss.fffffff'\n    ),\n    ''''\n)",
													"type": "Expression"
												},
												"queryTimeout": "02:00:00",
												"partitionOption": "None"
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "DS_azureSQL",
												"type": "DatasetReference",
												"parameters": {
													"DS_database": {
														"value": "@item().sql_server_database_name",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "DS_ADLS_csv",
												"type": "DatasetReference",
												"parameters": {
													"location": {
														"value": "@item().target_adls_directory",
														"type": "Expression"
													},
													"container": {
														"value": "@item().target_adls_container",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Update Audit Entry",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Incremental Copy",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.0:10:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[Update_audit_entry]",
											"storedProcedureParameters": {
												"AuditID": {
													"value": {
														"value": "@activity('Insert audit entry').output.firstRow.AuditID",
														"type": "Expression"
													},
													"type": "Int64"
												},
												"ErrorMessage": {
													"value": null,
													"type": "String"
												},
												"PipelineStatus": {
													"value": "Success",
													"type": "String"
												},
												"RowsCopied": {
													"value": {
														"value": "@activity('Incremental Copy').output.rowsRead",
														"type": "Expression"
													},
													"type": "Int64"
												},
												"RowsInserted": {
													"value": {
														"value": "@activity('Incremental Copy').output.rowsCopied",
														"type": "Expression"
													},
													"type": "Int64"
												},
												"RunEndTime": {
													"value": {
														"value": "@formatDateTime(utcNow())",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"WatermarkEndValue": {
													"value": {
														"value": "@activity('Get Max timestamp').output.resultSets[0].rows[0].max_ts",
														"type": "Expression"
													},
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_Azure_SQL",
											"type": "LinkedServiceReference",
											"parameters": {
												"database": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										}
									},
									{
										"name": "Update Config table",
										"type": "Script",
										"dependsOn": [
											{
												"activity": "Update Audit Entry",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.0:10:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "LS_Azure_SQL",
											"type": "LinkedServiceReference",
											"parameters": {
												"database": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "@concat(\n    'update sql_ingestion_config set WatermarkValue = ''',\n    formatDateTime(activity('Get Max timestamp').output.resultSets[0].rows[0].max_ts,'yyyy-MM-dd HH:mm:ss.fffffff'),\n    ''' where control_id = ''',\n    item().control_id, ''''\n\n)",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									},
									{
										"name": "Failure Update Audit",
										"type": "SqlServerStoredProcedure",
										"dependsOn": [
											{
												"activity": "Incremental Copy",
												"dependencyConditions": [
													"Failed"
												]
											}
										],
										"policy": {
											"timeout": "0.0:10:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"storedProcedureName": "[dbo].[Update_audit_entry]",
											"storedProcedureParameters": {
												"AuditID": {
													"value": {
														"value": "@activity('Insert audit entry').output.firstRow.AuditID",
														"type": "Expression"
													},
													"type": "Int64"
												},
												"ErrorMessage": {
													"value": {
														"value": "@activity('Incremental Copy').error.message",
														"type": "Expression"
													},
													"type": "String"
												},
												"PipelineStatus": {
													"value": "Failure",
													"type": "String"
												},
												"RowsCopied": {
													"value": null,
													"type": "Int64"
												},
												"RowsInserted": {
													"value": null,
													"type": "Int64"
												},
												"RunEndTime": {
													"value": {
														"value": "@formatDateTime(utcNow())",
														"type": "Expression"
													},
													"type": "DateTime"
												},
												"WatermarkEndValue": {
													"value": null,
													"type": "DateTime"
												}
											}
										},
										"linkedServiceName": {
											"referenceName": "LS_Azure_SQL",
											"type": "LinkedServiceReference",
											"parameters": {
												"database": {
													"value": "@item().sql_server_database_name",
													"type": "Expression"
												}
											}
										}
									}
								]
							}
						},
						{
							"name": "Insert audit entry",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.0:10:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderStoredProcedureName": "[dbo].[SQL_Ingestion_Insert_Audit_Entry]",
									"storedProcedureParameters": {
										"PipelineName": {
											"type": "String",
											"value": {
												"value": "@pipeline().Pipeline",
												"type": "Expression"
											}
										},
										"PipelineRunID": {
											"type": "String",
											"value": {
												"value": "@pipeline().RunId",
												"type": "Expression"
											}
										},
										"TriggerName": {
											"type": "String",
											"value": "Trg_Daily"
										},
										"TriggerType": {
											"type": "String",
											"value": "Manual"
										},
										"WatermarkStartValue": {
											"type": "DateTime",
											"value": {
												"value": "@item().WatermarkValue",
												"type": "Expression"
											}
										}
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_azureSQL",
									"type": "DatasetReference",
									"parameters": {
										"DS_database": {
											"value": "@item().sql_server_database_name",
											"type": "Expression"
										}
									}
								}
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-10-06T08:19:13Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}